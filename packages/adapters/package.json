{
  "name": "@bossjobs/adapters",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --exclude **/live.smoke.test.ts",
    "test:api": "vitest run src/boss/mapper.test.ts src/zhilian/mapper.test.ts src/api-contract.test.ts",
    "test:live": "vitest run src/live.smoke.test.ts",
    "probe:boss": "tsx src/scripts/probe-boss-api.ts",
    "probe:zhilian": "tsx src/scripts/probe-zhilian-api.ts"
  },
  "dependencies": {
    "@bossjobs/core": "workspace:*",
    "playwright": "^1.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
