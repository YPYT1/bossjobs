{
  "name": "bossjobs",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "dev:cli": "pnpm --filter @bossjobs/cli dev",
    "test": "pnpm -r --filter=./packages/* test",
    "test:unit": "pnpm --filter @bossjobs/core test && pnpm --filter @bossjobs/adapters test",
    "test:api": "pnpm --filter @bossjobs/adapters test:api",
    "test:live": "pnpm --filter @bossjobs/adapters test:live",
    "lint": "pnpm -r --filter=./packages/* exec tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}
